# See https://help.github.com/articles/ignoring-files for more about ignoring files.
/.bundle
/.env*
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/.keep
/storage/*
!/storage/.keep
/config/*.key
/node_modules
# Vite Ruby
/public/vite*
*.local
# Playwright / screenshot scratch
/tmp/screenshots
