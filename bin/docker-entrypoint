#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# No database setup here: the page is served from config/portfolio.yml and
# never touches Postgres. Add `./bin/rails db:prepare` once a CMS needs it.

exec "${@}"
